package-as: LunarSphere
enable-toc-creation: yes

manual-changelog:
  # Generated by the workflows from the newest section of LunarSphere/changelog.txt
  filename: CURSEFORGE_CHANGELOG.txt
  markup-type: plain

ignore:
  - README.md
  - CURSEFORGE_CHANGELOG.txt

move-folders:
  LunarSphere/LunarSphere: LunarSphere
  LunarSphere/LunarSphereExporter: LunarSphereExporter

